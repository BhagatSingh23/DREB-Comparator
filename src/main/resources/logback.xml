<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noisy libraries during benchmarks -->
    <logger name="org.knowm.xchart" level="WARN"/>
    <logger name="com.fasterxml.jackson" level="WARN"/>

    <!-- Framework logging -->
    <logger name="com.ratelimiter" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
